<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 5 source for PhoneMimi.
  Build via package.ps1 (which installs the WiX dotnet tool, stages files,
  and invokes `wix build`). See package.ps1 for the exact command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PhoneMimi"
           Manufacturer="CDinhh"
           Version="$(Version)"
           UpgradeCode="6F4E6B5C-2E4A-4B1F-9D2E-7B5C8F3A1E10"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <SummaryInformation Description="PhoneMimi — wireless screen mirroring for iOS and Android"
                        Manufacturer="CDinhh" />

    <!-- Block downgrades, allow seamless upgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of PhoneMimi is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Step-by-step wizard (Welcome, License, Folder, Install, Finish) in one window. -->
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="installer\dialog.bmp" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Apps & Features / Revo Uninstaller entry: icon, install path (for leftover scans), links. -->
    <Icon Id="AppIcon" SourceFile="resources\phonemimi.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CDinhh/PhoneMimi" />
    <!-- No System Restore point on install / uninstall. -->
    <Property Id="MSIFASTINSTALL" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!-- Passed by the setup.exe bundle (installer\Bundle.wxs), empty for a plain MSI install.
         Bundled: Uninstall shortcuts run the cached setup.exe so the bundle entry goes too. -->
    <Property Id="BUNDLE_ID" Secure="yes" />
    <Property Id="BUNDLE_EXE" Secure="yes" />
    <SetProperty Action="SetUninstallExeMsi" Id="UNINSTALL_EXE" Value="[System64Folder]msiexec.exe" After="AppSearch" Condition="NOT BUNDLE_EXE" />
    <SetProperty Action="SetUninstallArgsMsi" Id="UNINSTALL_ARGS" Value="/x [ProductCode]" After="AppSearch" Condition="NOT BUNDLE_EXE" />
    <SetProperty Action="SetUninstallExeBundle" Id="UNINSTALL_EXE" Value="[BUNDLE_EXE]" After="AppSearch" Condition="BUNDLE_EXE" />
    <SetProperty Action="SetUninstallArgsBundle" Id="UNINSTALL_ARGS" Value="/uninstall" After="AppSearch" Condition="BUNDLE_EXE" />

    <!-- Install directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PhoneMimi" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="PhoneMimi" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Files. The whole staging directory is harvested via wix.exe at build time
         (see package.ps1 which runs `heat` / `harvest`), but we also list the
         primary EXE explicitly so we can reference it for shortcuts and firewall. -->
    <ComponentGroup Id="MainExecutable" Directory="INSTALLFOLDER">
      <Component Id="cmpMainExe" Guid="*">
        <File Id="exe.OnePhoneMirror"
              Source="$(StagingDir)\PhoneMimi.exe"
              KeyPath="yes">

          <!-- Firewall: allow the EXE itself, both TCP and UDP, all profiles.
               Nesting under <File> binds the rule to this program path so
               Windows does not prompt the user on first listen. -->
          <fire:FirewallException Id="fwTcp"
                                  Name="PhoneMimi (TCP)"
                                  Protocol="tcp"
                                  Scope="any"
                                  Profile="all"
                                  IgnoreFailure="yes" />
          <fire:FirewallException Id="fwUdp"
                                  Name="PhoneMimi (UDP)"
                                  Protocol="udp"
                                  Scope="any"
                                  Profile="all"
                                  IgnoreFailure="yes" />
        </File>
      </Component>
    </ComponentGroup>

    <!-- Auto-harvested supporting files (DLLs, PNGs, license).  package.ps1 runs
         `wix.exe extension add` + a HarvestDirectory call to fill this group. -->
    <ComponentGroup Id="HarvestedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(StagingDir)\**">
        <!-- Don't double-add the main EXE handled above. -->
        <Exclude Files="$(StagingDir)\PhoneMimi.exe" />
      </Files>
    </ComponentGroup>

    <!-- Start Menu shortcut -->
    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="cmpStartMenu" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="PhoneMimi"
                  Description="Wireless screen mirroring for iOS and Android"
                  Target="[#exe.OnePhoneMirror]"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallStartMenu"
                  Name="Uninstall PhoneMimi"
                  Target="[UNINSTALL_EXE]"
                  Arguments="[UNINSTALL_ARGS]"
                  Icon="AppIcon" />
        <Shortcut Id="UninstallInFolder"
                  Directory="INSTALLFOLDER"
                  Name="Uninstall PhoneMimi"
                  Target="[UNINSTALL_EXE]"
                  Arguments="[UNINSTALL_ARGS]"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppShortcutFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\PhoneMimi"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="cmpDesktop" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="PhoneMimi"
                  Description="Wireless screen mirroring for iOS and Android"
                  Target="[#exe.OnePhoneMirror]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\PhoneMimi"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <!-- Bundled install: give the bundle's Apps & Features entry an install path for Revo. -->
      <Component Id="cmpBundleArpLocation" Directory="INSTALLFOLDER" Guid="5B0E7C2D-8A41-4F6E-9D3B-1C7A2E5F8B60" Condition="BUNDLE_ID">
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[BUNDLE_ID]"
                       Name="InstallLocation"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="PhoneMimi" Level="1">
      <ComponentGroupRef Id="MainExecutable" />
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

  </Package>
</Wix>
